# Copy to .env and fill in your values for local dev

# ===== Azure AI Agent Configuration (Agent-1) =====
AZURE_AI_PROJECT_ENDPOINT=https://<id>.services.ai.azure.com/api/projects/<project>
AZURE_AI_AGENT_ID=<your-agent-id>

# ===== LLM Configuration for LangChain Agents (Agent-2+) =====
# Provider: "azure_openai" or "openai"
LLM_PROVIDER=azure_openai

# Azure OpenAI settings (if using azure_openai provider)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# OpenAI settings (if using openai provider)
# OPENAI_API_KEY=<your-openai-api-key>
# OPENAI_MODEL=gpt-4o

# LLM Common Settings
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ===== Debug Settings =====
DEBUG=false
